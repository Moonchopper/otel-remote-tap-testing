--- a/processor/remotetapprocessor/channelset.go	2026-10-15 02:30:57.048269255 +0000
+++ b/processor/remotetapprocessor/channelset.go	2026-10-15 02:30:57.060791639 +0000
@@ -35,7 +35,12 @@
 func (c *channelSet) writeBytes(bytes []byte) {
 	c.mu.RLock()
 	for _, ch := range c.chanmap {
-		ch <- bytes
+		select {
+		case ch <- bytes:
+		default:
+			// This client is behind: drop its copy instead of waiting for it. Waiting here would hold
+			// up the pipeline, and would hold the read lock that closeAndRemove needs.
+		}
 	}
 	c.mu.RUnlock()
 }
