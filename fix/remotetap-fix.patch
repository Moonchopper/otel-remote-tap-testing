--- a/processor/remotetapprocessor/channelset_test.go	2026-10-15 02:30:57.058343959 +0000
+++ b/processor/remotetapprocessor/channelset_test.go	2026-10-15 02:30:57.066004291 +0000
@@ -12,7 +12,7 @@
 
 func TestChannelset(t *testing.T) {
 	cs := newChannelSet()
-	ch := make(chan []byte)
+	ch := make(chan []byte, 1) // client channels are buffered: writeBytes drops rather than waits
 	key := cs.add(ch)
 	go func() {
 		cs.writeBytes([]byte("hello"))
@@ -22,3 +22,25 @@
 	}, time.Second, time.Millisecond*10)
 	cs.closeAndRemove(key)
 }
+
+// A client that never reads must not block writeBytes, nor stop it from being removed.
+func TestChannelSetStuckClient(t *testing.T) {
+	cs := newChannelSet()
+	stuck := make(chan []byte, 1)
+	idx := cs.add(stuck)
+	done := make(chan struct{})
+	go func() {
+		for i := 0; i < 100; i++ {
+			cs.writeBytes([]byte("x"))
+		}
+		cs.closeAndRemove(idx)
+		cs.writeBytes([]byte("x"))
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("writeBytes or closeAndRemove blocked on a client that never reads")
+	}
+	assert.Len(t, cs.chanmap, 0)
+}
